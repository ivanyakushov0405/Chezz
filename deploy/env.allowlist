# Ключи секретов и переменных, которые выкатка пишет на VPS (OPERATIONS §7; design E02 П4, A2).
# Формат: разделы [prod], [ops], [staging]; строка — ИМЯ required|optional. Значений здесь нет.
# prod принимает [prod] и [ops], staging — только [staging]. Пустой optional не пишется;
# required без значения, ключ не из списка, APP_ENV не равный среде — код 2.

[prod]
APP_ENV required
APP_ORIGIN required
DATABASE_URL required
POSTGRES_PASSWORD required
GOOGLE_CLIENT_ID optional
GOOGLE_CLIENT_SECRET optional
COOKIE_SECRET optional
SENTRY_DSN optional

# APP_DOMAIN, ACME_EMAIL, SENTRY_INGEST → compose.prod.env; остальные → ops.env.
[ops]
APP_DOMAIN required
ACME_EMAIL required
SENTRY_INGEST required
TELEGRAM_BOT_TOKEN optional
TELEGRAM_CHAT_ID optional
B2_KEY_ID optional
B2_APP_KEY optional
B2_BUCKET optional
BACKUP_REQUIRE_OFFSITE optional

[staging]
APP_ENV required
APP_ORIGIN required
DATABASE_URL required
POSTGRES_PASSWORD required
SEED_TOKEN_SECRET required
GOOGLE_CLIENT_ID optional
GOOGLE_CLIENT_SECRET optional
COOKIE_SECRET optional
SENTRY_DSN optional
RATE_LIMIT_IP_PER_MIN optional
