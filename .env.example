# Пример переменных окружения для локального запуска app (design.md E01, «Выкатка и откат»).
# Только имена и безопасные локальные значения — секретов здесь нет (SECURITY §17).
# Скопируйте в .env (он в .gitignore) и запускайте: node --env-file=.env apps/server/src/main.ts

# dev | staging | prod (по умолчанию dev; staging/prod требуют APP_ORIGIN)
APP_ENV=dev
# origin SPA; в dev по умолчанию http://localhost:5173 (Vite проксирует /api, /auth, /ws на app)
APP_ORIGIN=http://localhost:5173
# локальная PostgreSQL из deploy/compose.test.yml (npm run db:test:up); пароль chezz — не секрет (OPERATIONS §6.4)
# база создаётся: DATABASE_URL=… node apps/server/scripts/prepare-db.ts
DATABASE_URL=postgres://chezz:chezz@127.0.0.1:54329/chezz_dev
HOST=127.0.0.1
PORT=3000
RATE_LIMIT_IP_PER_MIN=300
# каталог собранного SPA (по умолчанию apps/web/dist от корня репозитория)
WEB_DIST_DIR=apps/web/dist
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Тестовые утилиты (TESTING §7.1)
TEST_DATABASE_URL=postgres://chezz:chezz@127.0.0.1:54329/postgres
